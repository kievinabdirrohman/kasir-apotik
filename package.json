{
  "name": "apotek-azzainiyah",
  "private": true,
  "version": "1.0.2",
  "description": "Sistem Kasir Apotek — Operasional & Kasir (Web + Desktop Electron)",
  "author": "Apotek Az Zainiyah",
  "type": "module",
  "main": "electron-dist/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist electron-dist release",
    "lint": "tsc --noEmit",
    "dev:server": "tsx server.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "icon:generate": "node scripts/make-icon.mjs",
    "electron:compile": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --packages=external --outdir=electron-dist --out-extension:.js=.cjs",
    "electron:compile:watch": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --packages=external --outdir=electron-dist --out-extension:.js=.cjs --watch",
    "electron:run": "wait-on tcp:3000 && electron .",
    "electron:dev": "concurrently -k \"npm run dev\" \"npm run electron:compile:watch\" \"npm run electron:run\"",
    "electron:dist": "npm run build && npm run electron:compile && electron-builder --win"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.4",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wait-on": "^8.0.5"
  }
}
